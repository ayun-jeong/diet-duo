# ── Gemini API ──────────────────────────────────────────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
# 음식 영양성분 추정 + 운동 소모 칼로리 계산에 사용 (영양값의 유일한 출처)
GEMINI_API_KEY=AIzaSy...

# ── Supabase (로그인·기기 간 동기화·커플 공유 사용 시 필수) ────────────────────
# https://supabase.com → 프로젝트 → Settings → API
#
# DB 접근은 전부 서버(Next.js API 라우트)에서만 이루어진다.
# 그래서 NEXT_PUBLIC_ 접두사를 쓰지 않는다 — service_role 키는 RLS를 우회하므로
# 브라우저 번들에 절대 들어가면 안 된다.
#
# 미설정 시 로그인 없이 localStorage 전용 모드로 동작한다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # Settings → API → service_role (secret)

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=openssl rand -base64 32 결과값

# ── 카카오 로그인 ────────────────────────────────────────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 / 보안
KAKAO_CLIENT_ID=REST_API_키
KAKAO_CLIENT_SECRET=클라이언트_시크릿

# ── 모바일(Capacitor) 빌드 전용 (선택) ────────────────────────────────────────
# 앱에서 API·세션을 배포 서버로 보낼 때 사용
# NEXT_PUBLIC_API_URL=https://diet-duo.vercel.app
# NEXT_PUBLIC_NEXTAUTH_URL=https://diet-duo.vercel.app
